{
  "sourceLanguage": "en",
  "strings": {
    "protected.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device protected"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz korunuyor"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivo protegido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareil protégé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerät geschützt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivo protegido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство под защитой"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备受保护"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجهاز محمي"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは保護されています"
          }
        }
      }
    },
    "protected.subtitle.both": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please do not unplug the charger or close the lid"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen şarj kablosunu çıkarmayın ve kapağı kapatmayın"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, no desconecte el cargador ni cierre la tapa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de ne pas débrancher le chargeur ni fermer l’écran"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte das Ladekabel nicht abziehen und den Deckel nicht schließen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, não desconecte o carregador nem feche a tampa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, не отключайте зарядку и не закрывайте крышку"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请勿拔下充电器或合上屏幕"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرجى عدم فصل الشاحن أو إغلاق الغطاء"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電器を抜いたり、蓋を閉じたりしないでください"
          }
        }
      }
    },
