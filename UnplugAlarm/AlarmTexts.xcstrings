    },
    "protected.subtitle.lid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please do not close the lid"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen kapağı kapatmayın"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, no cierre la tapa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de ne pas fermer l’écran"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte den Deckel nicht schließen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, não feche a tampa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, не закрывайте крышку"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请勿合上屏幕"
