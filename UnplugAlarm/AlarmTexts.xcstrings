    "contact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If found, contact: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulunursa iletişim: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo encuentra, contacte: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous le trouvez, contactez : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls gefunden, bitte melden: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontrar, entre em contato: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если нашли, свяжитесь: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如拾获，请联系：%@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا وجدته، يُرجى الاتصال على: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拾われた方はこちらへご連絡ください：%@"
          }
        }
      }
    },
    "alarm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "THEFT ALERT"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HIRSIZLIK ALARMI"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ALERTA DE ROBO"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ALERTE AU VOL"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DIEBSTAHLALARM"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ALERTA DE ROUBO"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ТРЕВОГА: КРАЖА"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防盗警报"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنبيه سرقة"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "盗難警報"
          }
        }
      }
    },
    "alarm.unlock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this is your Mac, unlock to stop the alarm"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac sizinse, alarmı durdurmak için kilidi açın"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si este Mac es suyo, desbloquéelo para detener la alarma"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ce Mac vous appartient, déverrouillez-le pour arrêter l’alarme"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dies Ihr Mac ist, entsperren Sie ihn, um den Alarm zu stoppen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se este Mac for seu, desbloqueie-o para parar o alarme"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если это ваш Mac, разблокируйте его, чтобы выключить сигнал"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果这是您的 Mac，请解锁以停止警报"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان هذا جهاز Mac الخاص بك، فقم بإلغاء القفل لإيقاف الإنذار"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身のMacの場合は、ロックを解除してアラームを停止してください"
          }
        }
      }
    },
    "voice.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning! This MacBook was taken without permission."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikkat! Bu MacBook izinsiz alındı."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Atención! Este MacBook ha sido tomado sin permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention ! Ce MacBook a été pris sans autorisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung! Dieses MacBook wurde ohne Erlaubnis entwendet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenção! Este MacBook foi levado sem permissão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внимание! Этот MacBook взят без разрешения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "警告！这台 MacBook 未经允许被拿走。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحذير! تم أخذ جهاز MacBook هذا دون إذن."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警告！このMacBookは無断で持ち去られました。"
          }
        }
      }
    }
  },
  "version": "1.0"
}